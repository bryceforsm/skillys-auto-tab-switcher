{
  "manifest_version": 3,
  "name": "Skilly's Auto Tab Switcher",
  "description": "Automatically switches tabs at a set interval. Includes per-page refresh rules, auto-scrolling, and pausing on activity.",
  "version": "2.1.2",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "rules.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-timer": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Start or stop the timer in the current window"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_scroll.js"]
    }
  ]
}
